# 敏感字符串（API key 等）的 AES-256-GCM 加密密钥。
# 推荐：64 位十六进制字符（=32 字节）。其它字符串会被截断/补齐到 32 字节。
# 不设：从机器标识派生密钥（换机器后已加密的 API key 将无法解密）。
ENCRYPTION_KEY=

# SQLite 数据库路径（默认 backend/data.db）
WHAINOEL_DB_PATH=

# JSON 配置备份文件路径（默认 backend/config/user_config.json）
WHAINOEL_CONFIG_FILE=

# 数据目录（默认 backend/data）
WHAINOEL_DATA_DIR=

# Redis（可选；未安装/不可用时自动降级为无缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
